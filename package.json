{
  "name": "context-bridge",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.11.10"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "pele": "^1.8.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  }
}
