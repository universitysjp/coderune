{
  "name": "coderune",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "turbo run build",
    "check": "vp check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:desktop": "cargo run -p coderune-desktop",
    "dev:web": "turbo run dev --filter=web",
    "fix": "vp check --fix",
    "lint": "turbo run lint",
    "prepare": "vp config --no-agent",
    "test": "cargo test --workspace",
    "typecheck": "bun check",
    "wbs:render": "bun scripts/render-wbs.ts",
    "build:desktop": "cargo build --release -p coderune-desktop",
    "check:desktop": "cargo check -p coderune-desktop",
    "test:desktop": "cargo test",
    "setup:rune": "bash scripts/fetch-rune.sh",
    "verify:ui": "bash scripts/verify-ui.sh"
  },
  "dependencies": {},
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "pele": "^1.8.0",
    "turbo": "^2.11.10",
    "ultracite": "^8.0.1",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  }
}
