{
  "name": "coderune",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "vp check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev --filter=web",
    "dev:all": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=coderune-desktop",
    "dev:web": "turbo run dev --filter=web",
    "fix": "vp check --fix",
    "lint": "turbo run lint --filter=./apps/* --filter=./crates/*",
    "prepare": "vp config --no-agent",
    "test": "turbo run test --filter=./apps/* --filter=./crates/*",
    "typecheck": "bun check",
    "wbs:render": "bun scripts/render-wbs.ts",
    "build:desktop": "turbo run build --filter=coderune-desktop -- --release",
    "check:desktop": "turbo run check --filter=coderune-desktop",
    "test:desktop": "turbo run test --filter=coderune-desktop",
    "setup:rune": "bash scripts/setup-rune.sh",
    "verify:ui": "bash scripts/verify-ui.sh",
    "skills:ts": "bun scripts/skills-to-typescript.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "pele": "^1.8.0",
    "turbo": "^2.11.10",
    "ultracite": "^8.0.1",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  }
}
